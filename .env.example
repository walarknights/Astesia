EXPO_PUBLIC_QWEATHER_KEY=your_qweather_key_here
EXPO_PUBLIC_QWEATHER_API_HOST=https://your-api-host.re.qweatherapi.com
EXPO_PUBLIC_QWEATHER_GEO_HOST=https://your-api-host.re.qweatherapi.com
EXPO_PUBLIC_QWEATHER_WEATHER_HOST=https://your-api-host.re.qweatherapi.com
EXPO_PUBLIC_AKSHARE_API_HOST=http://astesia.cc
# 前端后端请求统一使用真实服务域名；本地调试后端请临时覆盖，不要提交本地地址。
EXPO_PUBLIC_AI_API_HOST=http://astesia.cc

# 后端服务端口
AI_SERVER_HOST=127.0.0.1
AI_SERVER_PORT=8787

# PostgreSQL 连接配置
DATABASE_URL=postgresql://postgres:replace_with_db_password@127.0.0.1:5432/astesia
# 本机 PostgreSQL 通常填写 false；云数据库通常填写 true
DATABASE_SSL=false

# 生产环境必须替换成随机长密钥
AUTH_TOKEN_SECRET=replace_with_a_long_random_secret

# Brevo SMTP 验证码邮件配置
# SMTP server 固定为 smtp-relay.brevo.com
# SMTP user 需填写你的 Brevo SMTP 登录邮箱
# SMTP key 需填写 Brevo SMTP key，不要提交到版本库
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
BREVO_SMTP_FROM_EMAIL=
BREVO_SMTP_FROM_NAME=Astesia
# 仅建议本地联调时开启，开启后接口会直接返回验证码
AUTH_RETURN_DEBUG_VERIFICATION_CODE=false

# 至少配置一种 AI 提供方
NITRO_ROUTER_API_KEY=
NITRO_ROUTER_MODEL=gemini-3.1-pro-preview
DEEPSEEK_API_KEY=
DEEPSEEK_TITLE_MODEL=deepseek-v4-flash

# 可选：AI 聊天与初始额度配置
AI_CHAT_MAX_OUTPUT_TOKENS=4096
AI_INITIAL_BALANCE_USD=1
