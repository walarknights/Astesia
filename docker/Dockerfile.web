# syntax=docker/dockerfile:1

FROM node:22-alpine AS admin-build

WORKDIR /app/admin-web

RUN corepack enable && corepack prepare pnpm@10.12.1 --activate

COPY .npmrc ./
COPY admin-web/package.json admin-web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY admin-web ./

ARG PUBLIC_BASE_URL=https://astesia.cc
ENV VITE_API_BASE_URL=${PUBLIC_BASE_URL}

RUN pnpm exec tsc -b \
  && pnpm exec vite build --outDir /app/admin-dist --emptyOutDir

FROM nginx:1.27-alpine AS runtime

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY index.html /usr/share/nginx/promo/index.html
COPY public /usr/share/nginx/promo/
COPY --from=admin-build /app/admin-dist/ /usr/share/nginx/admin/

EXPOSE 80
